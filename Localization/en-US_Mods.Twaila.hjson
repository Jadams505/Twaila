	PanelContextData: {
		Tooltip: ""

		SyncPositionData: {
			Label: Sync Position Data
			Tooltip:
				'''
				Syncs all the position data below with the Closed Inventory data
				If ON editing data other than Closed Inventory will have no effect
				If OFF you can set the position presets below to change the panel's position based on certain criteria
				'''
		}

		ClosedInventory: {
			Label: Closed Inventory
			Tooltip: Information about where to position the panel when your inventory is closed
		}

		OpenInventory: {
			Label: Open Inventory
			Tooltip: Information about where to position the panel when your inventory is open
		}

		InFullscreenMap: {
			Label: In Fullscreen Map
			Tooltip: Information about where to position the panel when in the fullscreen map
		}
	}

	PositionData: {
		Tooltip: ""

		UseDefaultPosition: {
			Label: Use Default Position
			Tooltip: Dragging the panel automatically disables this
		}

		LockPosition: {
			Label: Lock Position
			Tooltip: When this is OFF you can use the mouse to move the panel
		}

