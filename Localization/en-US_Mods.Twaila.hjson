Keybinds: {
	CycleUIDisplayMode.DisplayName: Cycle UI Display Mode
	NextContext.DisplayName: Next Context
	PreviousContext.DisplayName: Previous Context
	CycleContextMode.DisplayName: Cycle Context Mode
}

Contexts: {
	Tile: Tile
	Wall: Wall
	Liquid: Liquid
	Wire: Wire
	Npc: Npc
}

WallId: Wall Id: {0}
TileId: Tile Id: {0}
LiquidId: Liquid Id: {0}
WaterStyle: Water Style: {0}
CurrentContext: Current Context: {0}
ContextModeMessage: "{$ContextMode}: {0}"
DisplayModeMessage: "{$UIDisplay}: {0}"
PercentPickPower: % Pick Power
GreenCheck: "[c/00FF00:✓]"
RedX: "[c/FF0000:✗]"
GoodPickPower: "{$GreenCheck} {0}{$PercentPickPower}"
BadPickPower: "{$RedX} {0}{$PercentPickPower}"

WireColor: {
	Red: Red
	Blue: Blue
	Green: Green
	Yellow: Yellow
}

WireText: "{$ItemName.Wire}: {0}"

Defaults: {
	Name: Default Name
	Text: Default Text
	Liquid: Default Liquid
}

RecommendedPick: "{0} {1}%"
HappinessText: Happiness: {0}

Configs: {
	TwailaConfig: {
		DisplayName: Mod Config

		Headers: {
			Features: Features
			UIPosition: UI Position
			UIPanel: UI Panel
			UIText: UI Text
			UIImage: UI Image
		}

		AntiCheat: {
			Label: Anti Cheat Settings
			Tooltip: Various settings to prevent cheating
		}

		DisplayContent: {
			Label: Content Toggles
			Tooltip: ""
		}

		MaxWidth: {
			Label: Max Width (%)
			Tooltip: Maximum % of the screen's width the panel can be
		}

		MaxHeight: {
			Label: Max Height (%)
			Tooltip: Maximum % of the screen's height the panel can be
		}

		PanelPadding: {
			Label: Panel Padding
			Tooltip: ""
		}

		CycleDelay: {
			Label: Cycle Delay
			Tooltip: The amount of time in ticks before the panel will cycle to the next type
		}

		ContentSetting: {
			Label: Content Setting
			Tooltip: ""
		}

		HoverOpacity: {
			Label: Hover Opacity
			Tooltip: ""
		}

		ContextMode: {
			Label: Context Mode
			Tooltip: ""
		}

		ShowBackground: {
			Label: Show Background
			Tooltip: ""
		}

		ShowInFullscreenMap: {
			Label: Show In Fullscreen Map
			Tooltip: ""
		}

		UIDisplaySettings: {
			Label: UI Display
			Tooltip: ""
		}

		PanelColor: {
			Label: Panel Color
			Tooltip: ""
		}

		TextShadow: {
			Label: Text Shadow
			Tooltip: ""
		}

		OverrideColor: {
			Label: Override Color
			Tooltip: Turn this on to override any pre-existing text color
		}

		TextColor: {
			Label: Text Color
			Tooltip: ""
		}

		UseItemTextures: {
			Label: Use Item Textures
			Tooltip: ON: Uses the texture of the item that place the tile. OFF: Uses the texture of the sprite in the world
		}

		ReservedImageWidth: {
			Label: Reserved Image Width (%)
			Tooltip: The % of the panel's width that is allocated for the image when the text is too long
		}

		UseTextHeightForImage: {
			Label: Use Text Height For Image
			Tooltip: Shrinks the image height to be aligned with the text height
		}

		PanelPositionData: {
			Label: Panel Position Data
			Tooltip: Data about where to position the panel based on certain criteria like inventory open or closed
		}

		UseDefaultPosition: {
			Label: Use Default Position
			Tooltip: ""
		}

		LockPosition: {
			Label: Lock Position
			Tooltip: ""
		}

		AnchorX: {
			Label: Anchor X
			Tooltip: ""
		}

		AnchorY: {
			Label: Anchor Y
			Tooltip: ""
		}

		AnchorPosX: {
			Label: Anchor Pos X
			Tooltip: ""
		}

		AnchorPosY: {
			Label: Anchor Pos Y
			Tooltip: ""
		}

		CurrentContext: {
			Label: Current Context
			Tooltip: ""
		}
	}

	AntiCheatSettings: {
		Tooltip: ""

		HideUnrevealedTiles: {
			Label: Hide Unrevealed Tiles
			Tooltip: Hides tiles that are not revealed on the player's map
		}

		HideWires: {
			Label: Hide Wires
			Tooltip: Hides wires that the player cannot see
		}

		HideEchoTiles: {
			Label: Hide Echo Tiles
			Tooltip: Hides echo tiles that the player cannot see
		}

		HideSuspiciousTiles: {
			Label: Hide Suspicious Tiles
			Tooltip: Hides tiles that are supposed to be a trick (Life Crystal Boulders, Dirtiest Block, Dead Man's Chests, etc)
		}
	}

